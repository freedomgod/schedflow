# =============================================================================
# SchedFlow environment template
# Copy this file to .env and adjust values as needed.
# =============================================================================

# ── App ──────────────────────────────────────────────
# Defaults to production: hot reload off, INFO logs.
# APP_ENV=production

# ── Server ───────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# RELOAD=false
# WORKERS=1

# ── Logging ──────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Metadata DB ──────────────────────────────────────
# Relative paths resolve against the project root.
# SCHEDFLOW_META_DB=data/scheduler_meta.db

# ── Redis jobstore ───────────────────────────────────
# SCHEDFLOW_REDIS_HOST=localhost
# SCHEDFLOW_REDIS_PORT=6379
# SCHEDFLOW_REDIS_USERNAME=
# SCHEDFLOW_REDIS_PASSWORD=
# SCHEDFLOW_REDIS_DB=0

# ── MongoDB jobstore ─────────────────────────────────
# SCHEDFLOW_MONGODB_HOST=localhost
# SCHEDFLOW_MONGODB_PORT=27017
# SCHEDFLOW_MONGODB_USERNAME=
# SCHEDFLOW_MONGODB_PASSWORD=
# SCHEDFLOW_MONGODB_AUTH_SOURCE=admin

# ── Docker 部署 ───────────────────────────────────────
# .env.example 会随镜像复制到容器 /app/.env.example，作为参考模板。
# docker compose 会把项目根目录的 .env 挂载到容器 /app/.env，并自动设置
# SCHEDFLOW_ENV_FILE=/app/.env，应用启动时直接读取该文件——编辑宿主机 .env
# 后执行 `docker compose restart` 即生效（挂载为只读，改动在宿主机侧）。
# 部署前请先复制一份：cp .env.example .env

# 宿主机端口绑定地址。默认 127.0.0.1：仅供本机/反代访问，公网流量由
# nginx/Caddy 等反代转发进来（推荐生产模式）；若要让公网直接访问
# IP:端口（不推荐），改为 0.0.0.0。
# SCHEDFLOW_BIND_HOST=127.0.0.1
# 宿主机访问端口（容器内端口固定为 8000 / 4173）
# SCHEDFLOW_API_PORT=8000
# SCHEDFLOW_WEB_PORT=4173
# web 容器 /api 代理目标。compose 内网默认 http://api:8000；
# 部署到远端平台时改为 api 服务的公网地址。
# SCHEDFLOW_API_URL=http://api:8000
# 容器内元数据库路径（默认挂载卷 data/ 下）
# SCHEDFLOW_META_DB=/app/data/scheduler_meta.db
