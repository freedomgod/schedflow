# =============================================================================
# SchedFlow environment template
# Copy this file to .env and adjust values as needed.
# =============================================================================

# ── App ──────────────────────────────────────────────
# Defaults to production: hot reload off, INFO logs.
# APP_ENV=production

# ── Server ───────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# RELOAD=false
# WORKERS=1

# ── Logging ──────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Metadata DB ──────────────────────────────────────
# Relative paths resolve against the project root.
# SCHEDFLOW_META_DB=data/scheduler_meta.db

# ── Redis jobstore ───────────────────────────────────
# SCHEDFLOW_REDIS_HOST=localhost
# SCHEDFLOW_REDIS_PORT=6379
# SCHEDFLOW_REDIS_USERNAME=
# SCHEDFLOW_REDIS_PASSWORD=
# SCHEDFLOW_REDIS_DB=0

# ── MongoDB jobstore ─────────────────────────────────
# SCHEDFLOW_MONGODB_HOST=localhost
# SCHEDFLOW_MONGODB_PORT=27017
# SCHEDFLOW_MONGODB_USERNAME=
# SCHEDFLOW_MONGODB_PASSWORD=
# SCHEDFLOW_MONGODB_AUTH_SOURCE=admin
