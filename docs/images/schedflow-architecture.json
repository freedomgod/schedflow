  "cards": [
    {
      "dot": "emerald",
      "title": "主路径",
      "items": [
        "用户 / 调用方经 REST / SSE 创建、管理与查看定时工作流",
        "Scheduler 到期后按 executor_alias 派发，Executor 运行 Workflow DAG",
        "节点结果汇总为 ExecutionLog，并持久化到 JobStore",
        "运行快照（RunSnapshot）支撑 full/resume 断点续跑与 on_restart 自动恢复"
      ]
    },
    {
      "dot": "cyan",
      "title": "轻量设计",
      "items": [
        "单进程即可运行：API 层与 core 调度栈同进程协作",
        "内置 MemoryJobStore 与线程 / 进程 / 异步执行器，可零外部依赖起步",
        "需要时按 jobstore_alias / executor_alias 切换外部实现"
      ]
    },
    {
      "dot": "violet",
      "title": "图中约定与扩展",
      "items": [
        "“用户 / 调用方”泛指仓库外的 Web UI、CLI 等接入端",
        "触发器、执行器、存储器走静态注册表扩展",
        "认证（JWT / API Key）保护管理与执行接口",
        "workflow_timeout 提供 DAG 级墙钟总超时",
        "EventBus 订阅者可将事件外发到 Webhook / Prometheus / SSE（无消息中间件）"
      ]
    }
  ]
